	quest.7E971B325ED93F82.quest_desc: ["生成于糖果龋洞之中，通常可以在地表的巨大冰淇淋球顶端发现用于点缀的巨大甜浆果。"]
	quest.7E971B325ED93F82.quest_subtitle: "比甜浆果大"
	quest.7EA7517D5106A83E.quest_desc: [
		"&e用途：逐张查询当前可获取卷轴及其解锁内容。"
		"&b使用：将卷轴放在锻造区附近供工作台读取。"
