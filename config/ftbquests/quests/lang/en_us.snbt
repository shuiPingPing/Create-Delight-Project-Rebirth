	quest.7D65EC61C0EDC6D7.quest_desc: [" &l具体操作方法详见&4https://www.mcmod.cn/post/3679.html&r"]
	quest.7D65EC61C0EDC6D7.quest_subtitle: "可以让朋友听到你的网易云音乐歌单！"
	quest.7D65EC61C0EDC6D7.title: "音乐大师"
	quest.7D6E59F236540559.quest_subtitle: "可随身携带的无限流体池"
	quest.7D7F82D2E50E2CDF.quest_subtitle: "钻石充能！"
	quest.7DC98E34AECFBB5C.quest_subtitle: "使用&e探矿仪&r来寻找&4矿物痕迹"
	quest.7DC98E34AECFBB5C.title: "让我看看你在哪~"
	quest.7DCA89E5DFCE50DB.quest_desc: [
		"袋獾生成在温带森林群系中，属于中立型生物。"
		""
		"袋獾（亦称塔斯马尼亚恶魔）是一种生活在森林生物群系及其变种中的小型有袋类哺乳动物，你可以通过那黑白相间的皮毛和奇怪的叫声来辨别它们。它们有时会坐着或趴着晒太阳。它们会成群结队的狩猎鸡和兔子。"
		""
		"袋獾可以抵御来自几乎所有生物的袭击，如果玩家喂食袋獾它们最爱吃的腐肉，它们便会发出奇怪的吼叫来驱赶周围的怪物。袋獾无法驯服，但可以通过喂食任何肉类来进行繁殖。"
	]
	quest.7DCA89E5DFCE50DB.quest_subtitle: "“有袋类动物当中的小刺头，喜欢吃腐肉。”“如果你愿意给它们点吃的的话，它们就会用它们古怪的气味和声音帮你驱赶周围的怪物，当然了，这也可能是它们端起碗吃肉放下碗骂娘的行为。”"
	quest.7DCA89E5DFCE50DB.title: "袋獾"
	quest.7DD494295398C5F3.quest_desc: [
		"&e用途：【需要星界统御卷轴】提供较低倍率的独立全伤害增幅。"
		"&b适合：安装在“徽纹”槽位。"
		"&d需要：星界统御。"
		"{\"text\":\"查看卷轴：星界统御\",\"underlined\":true,\"color\":\"aqua\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"70BB8E19BB4E73B1\"}}"
	]
	quest.7DD494295398C5F3.title: "复仇者徽章"
	quest.7DD6AE3D040FB1AE.quest_subtitle: "上传你的大作！"
	quest.7DED9A87C6CB80F0.quest_subtitle: "{\"text\":\"启动飞行模式！\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7DED9A87C6CB80F0\"}}"
	quest.7E1B33C0877F38CF.quest_desc: [
		"&e用途：具有一定弧度的利刃，可以在战斗中不断削减敌人的最大生命值。"
		"&b适合：安装在“剑刃”槽位。"
