	quest.03194F6C5C2D8686.quest_subtitle: "古希腊掌管服务器的神"
	quest.03203B1E3F2A96CA.quest_desc: [
		"&e用途：衬裤能为护腿提供较高的完整度，且不会降低敏捷。"
		"&b适合：安装在“内衬”槽位。"
