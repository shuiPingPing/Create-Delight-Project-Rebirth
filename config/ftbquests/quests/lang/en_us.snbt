		"&b适合：安装在“附件”槽位。"
		"&d需要：默认可用，或随对应图纸解锁。"
	]
	quest.1AC172FA9E6C79A9.title: "弩箭加速器"
	quest.1AC39FA116DC9F92.quest_desc: [
