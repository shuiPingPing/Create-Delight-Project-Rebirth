	quest.1C23480EDBBC9067.title: "&6远程、防御与携行"
	quest.1C29A2685FA88F91.quest_desc: ["套装能够避免&4血液&r溅到身上"]
	quest.1C29A2685FA88F91.quest_subtitle: "&4冷酷，精准，高效，且专业。"
	quest.1C29A2685FA88F91.title: "屠夫套装"
	quest.1C4EA0FC584EFC28.quest_desc: ["&e重力方块&r，不可直接食用，榴莲&e成熟后&r会&4从树叶上掉落&r并造成&4伤害"]
	quest.1C4EA0FC584EFC28.quest_subtitle: "榴莲树极其少量自然生成于&e沼泽&r、&e红树林沼泽&r、&e丛林&r、&e竹林&r和&e稀疏的丛林"
	quest.1C870AB59DC819B5.quest_desc: [
		"击杀夜行蝠掉落夜行蝠翼，可合成夜行蝠煲"
		"给予玩家时长为120秒的&9夜视II&r效果，为玩家在黑暗的异寂空谷中的探索提供便利。"
	]
	quest.1C870AB59DC819B5.quest_subtitle: "众神之父请赐予我视野"
	quest.1CB33EA048068637.quest_desc: [
