	quest.48EC662CDE792B76.quest_desc: ["本整合包增加了一系列来自alex的生物，如有不了解的问题可以查看&4任务书内相关章节&r"]
	quest.48EC662CDE792B76.quest_subtitle: "{\"text\":\"来自Alex的生物\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"329597CAA8B8D983\"}}"
