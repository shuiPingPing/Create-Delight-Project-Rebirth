	quest.1ABB1CC7C1D6566E.quest_subtitle: "种植于&9复生沃土&r上产生的特殊产物"
	quest.1ABCEF1F39620DE5.quest_desc: ["使用&e列表或者属性过滤器&r，可以将仓储网络的东西分类"]
	quest.1ABCEF1F39620DE5.title: "物品分类"
	quest.1AC172FA9E6C79A9.quest_desc: [
