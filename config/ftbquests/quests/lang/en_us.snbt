	quest.548ACB7AEFD5E1DE.quest_desc: [
		"用于&4加载所在ME网络经过的所有区块及维度&r。可以配合量子网桥使用。"
		"若一个ME网络经过主世界和下界两个维度，则你需要在主世界和下界分别放置一个与该网络相连的空间锚，才能确保这个网络在两个维度所经过的区块都被加载。"
	]
	quest.548ACB7AEFD5E1DE.quest_subtitle: "卡服神器"
	quest.5491A2556462B339.quest_desc: [
