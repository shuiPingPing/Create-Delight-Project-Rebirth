	quest.6345A669963AC5F1.quest_desc: [
		"放置后随机向外发射电流，并对击中的生物造成伤害，被击中的苦力怕和村民会变成闪电苦力怕和女巫。"
		"挖掘后会发生爆炸！"
	]
