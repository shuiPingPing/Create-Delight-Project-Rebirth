	quest.5649C232503A8C1C.quest_desc: ["千万别让熔岩直接碰到蜂蜜源，否则……"]
	quest.5649C232503A8C1C.quest_subtitle: "&4流动熔岩&r碰到&4流动蜂蜜&r=石灰岩"
	quest.56581EA4D362850F.quest_desc: [
