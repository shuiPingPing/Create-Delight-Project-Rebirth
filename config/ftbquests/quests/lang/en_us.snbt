	quest.2B217BFD6C87D754.quest_desc: [
		"&6「无名的英雄」愿全世之座爱佑其身，赐予负世的意志"
		"&7异世的盗火者身负三千万转轮回之火种，再度燃起徒劳的火焰。"
		"&7卷中记载了可根据击杀数提升伤害的特殊改进。"
		"&b使用：放置在锻造区附近后打开加工台。"
	]
	quest.2B217BFD6C87D754.title: "其五·负世伟业"
	quest.2B4939BD8F985C5A.quest_desc: ["因为LightmansCurrency加入的各种各样形式的交易商店本质是一样的，所以这里只会介绍几个大类的商店物品。"]
	quest.2B4939BD8F985C5A.quest_subtitle: "制作自己商店的必要品！"
	quest.2B7A43D2994E46C6.quest_desc: [
		"&7上面记载了用龙血淬炼武器的技巧，并记录了将龙血与龙骨材质部件结合的方法。"
		"&7两个操作都可以令工具拥有对巨龙更强的杀伤力。"
		"&b使用：放置在锻造区附近后打开加工台。"
	]
	quest.2B7A43D2994E46C6.title: "龙血淬炼法"
	quest.2B96D7585802C9AC.quest_desc: [
		"         在地狱击杀妖精召唤（因为本整合包未加车万女仆，具体召唤方式见任务“星条旗的小丑”）。"
		"         生命值：200点，限伤10点。"
		"         攻击方式：弹幕攻击10点（无视护甲），使用大量的持续存在的激光弹幕进行攻击。"
		"         掉落物：狱符「星星与条纹」(弹幕击败掉落） 。 "
		"        （狱符「星星与条纹」介绍在下一页）"
		"{@pagebreak}"
		"         狱符「星星与条纹」 ："
		"         使用4点伤害的大量激光弹幕对目标进行持续攻击。"
		"         消耗1个红色激光弹幕。"
		"         使用弹幕击败克劳恩皮丝掉落。"
	]
	quest.2B96D7585802C9AC.quest_subtitle: "使人发狂程度的能力"
	quest.2B96D7585802C9AC.title: "「地狱的妖精」——克劳恩皮丝"
	quest.2BA53576141562AD.quest_subtitle: "用它来精制谷物！"
	quest.2BC23C199544A1DB.title: "简单装饰一下我的齿轮组们~"
