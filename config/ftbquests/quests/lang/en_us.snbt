		"&b选择：按用途与手感挑选，不按材料数值拆页。"
	]
	quest.3FB7597DDDD13BD4.title: "&b手柄"
	quest.3FBB6127631F12DA.quest_subtitle: "使用&e夏季温室心髓&r右键&4温室之心室&r，可直接获得完成态温室之心"
	quest.3FC12639256FB454.quest_desc: [
		"&e「黄金的织者」愿黄金之茧爱佑其身，赐予浪漫的渴求"
		"&7异世的织者将光阴织成金丝，其中散落的一缕被无名工匠所获，"
		"&7制成可以削减敌人无敌帧的锻造书卷。"
		"&b使用：放置在锻造区附近后打开加工台。"
	]
	quest.3FC12639256FB454.title: "其四·浪漫相伴"
	quest.3FCAD432A639DA2E.quest_desc: [
		"&e用途：【需要重装守御卷轴】将护心镜改为装甲基底。"
		"&b适合：安装在“基底”槽位。"
		"&d需要：重装守御。"
		"{\"text\":\"查看卷轴：重装守御\",\"underlined\":true,\"color\":\"aqua\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2B1949EAEA5799F7\"}}"
	]
	quest.3FCAD432A639DA2E.title: "坚固基底"
	quest.3FDF8BAF62B5B873.quest_subtitle: "高击退弹射物"
	quest.3FF2A613B198166F.quest_desc: [
		"&e用途：【需要雷鸣战技卷轴】自带攻击距离、交互距离与攻击力。"
		"&b适合：安装在“手套”槽位。"
		"&d需要：雷鸣战技。"
		"{\"text\":\"查看卷轴：雷鸣战技\",\"underlined\":true,\"color\":\"aqua\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"6ABDD3C44A9FD0CC\"}}"
	]
	quest.3FF2A613B198166F.title: "坚硬手套"
	quest.4009EC8FF2311EEC.quest_desc: [
		"&e用途：汇总“坠饰”槽位的当前可用模块。"
		"&b选择：按用途与手感挑选，不按材料数值拆页。"
	]
	quest.4009EC8FF2311EEC.title: "&b坠饰"
	quest.4049CADF45E69ED9.quest_desc: [
		"&e用途：【需要远古净化卷轴】为法术等特殊伤害的触发列表加入一种状态效果。"
		"&b适合：安装在“七种色彩模块”槽位。"
