	quest.4F7F4970E26CBD75.quest_desc: ["需要与被筛选的有混合流体的容器&l&e直接接触&r&r才能正确过滤。"]
	quest.4F7F4970E26CBD75.quest_subtitle: "凑合用吧，难不成依赖工作盆自动输出吗"
	quest.4F8AB610C9119A96.quest_desc: ["对原始世界的生物（除三叶虾）使用琥珀珍品或板块碎片可以消耗对应物品将它转换为“复古”和“爆燃”形态，再次使用会将其变回普通形态。不同形态除外观外和一般的遗迹恐手龙没有区别。"]
	quest.4F8DA294A7118B1F.quest_desc: ["&e用途：汇总命运组的三张泰坦卷轴。"]
	quest.4F8DA294A7118B1F.title: "&b泰坦卷轴·命运"
	quest.4FA1676749F2A433.quest_desc: [
		"&e用途：【需要蜂巢守护卷轴】提供基础伤害减免。"
		"&b适合：安装在“镯环”槽位。"
		"&d需要：蜂巢守护。"
		"{\"text\":\"查看卷轴：蜂巢守护\",\"underlined\":true,\"color\":\"aqua\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"721B61FDF7A96289\"}}"
	]
	quest.4FA1676749F2A433.title: "抗性手镯"
	quest.4FA3458D70BC2025.quest_desc: [
