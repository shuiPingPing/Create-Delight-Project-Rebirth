	quest.638505D6DDD35EF8.quest_desc: ["使用机械动力的合成方式能获得越多收益！对于多种合成方式，越复杂的成本越低！"]
	quest.638505D6DDD35EF8.quest_subtitle: "{\"text\":\"转入下一章节\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"2CAE49FE48790F23\"}}"
