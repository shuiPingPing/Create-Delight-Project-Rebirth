	quest.69844CCA1F887224.quest_subtitle: "增加你的机器的交易相关的交互频率（用于交易自动化）"
	quest.6993F7FC751ADB38.quest_desc: ["在遗迹中，我还发现了一些酷似电池的物品。这应该就是笔记中提到的热电池，只需将它们&e安装在锻造锤上&r，便能为其提供能量。"]
	quest.69944633AC8D22F7.quest_desc: [
