	]
	quest.1AC39FA116DC9F92.title: "纯白剑鞘"
	quest.1ADBDFB31928124D.quest_subtitle: "记得管道要连接到&4基岩&r上！"
	quest.1ADBDFB31928124D.title: "寻找原油！然后开发！"
	quest.1AE78824AE3CE5F5.quest_subtitle: "所谓“全能”，就是能够存储所有种类的东西（本包中可以存储物品和流体）"
	quest.1AE78824AE3CE5F5.title: "全能存储组件"
	quest.1AEF15311062E1AD.quest_desc: [
		"&e用途：小圆盾是小型盾牌。"
		"&b适合：安装在“盾面”槽位。"
		"&d需要：默认可用，或随对应图纸解锁。"
