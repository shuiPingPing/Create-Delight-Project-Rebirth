	]
	quest.7B6DD206D20AD334.title: "简易剑柄"
	quest.7B7258CB2FDF4243.quest_subtitle: "每次输出&4一组&r！"
	quest.7B766B7184A66717.quest_desc: ["怪物的触须在锅里咕噜噜"]
	quest.7B766B7184A66717.quest_subtitle: "来烹饪怪物"
	quest.7B8726FD783DE147.quest_desc: [
		"&e用途：【需要远古净化卷轴】为法术等特殊伤害的触发列表加入一种状态效果。"
