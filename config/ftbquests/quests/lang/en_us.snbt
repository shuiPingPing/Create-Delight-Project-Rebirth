	quest.5901D18C4E177068.title: "直接无序合成"
	quest.591CA06C6483B19B.quest_desc: [
		"按扫描仪写入星图的坐标前往破损空间站。站内遥测储存箱保存着残损的月背记录。"
		"把记录与星图放入天文台，即可让月背异常区成为正式火箭目的地。"
	]
	quest.591CA06C6483B19B.title: "破损空间站"
	quest.592B86772585084E.quest_subtitle: "哎哟我，给烈焰人冻成⑨了"
	quest.59350A53C2738BD9.quest_desc: ["机械动力（Create）是一个围绕着建筑、装饰和机械的新兴模组，所添加的元素旨在为玩家提供全新的建筑与自动化体验，并尽可能多地为玩家预留自定义空间。在机器与能源方面，模组做出了极大的创新。机器不再由传统科技模组中乏味的电线供能，而是需要玩家搭建机械传动系统驱动。&4任务书中的相关内容&f会引导大家制造一个实用的机器。"]
	quest.59350A53C2738BD9.quest_subtitle: "{\"text\":\"欢迎来到机械动力！世界就在你的手中！\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"510B2EE25982FD73\"}}"
	quest.59350A53C2738BD9.title: "欢迎来到机械动力"
