	quest.696A502F48B90A6E.quest_desc: [
		"本章并非必须完成的内容"
		"旨在介绍整合包添加的常用&e基础材料&r增产方式的流程，以帮助搭建基础材料增产产线"
		"（即通过更多工序，来提高相同原料消耗下的产量）"
	]
	quest.6974DE22C7CD87D7.quest_desc: [
