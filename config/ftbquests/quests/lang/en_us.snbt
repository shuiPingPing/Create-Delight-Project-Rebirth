	quest.326F31C128FA35F7.quest_subtitle: "西瓜生成于&e丛林&r，破坏后可获得&e西瓜片"
	quest.32871E311DB7FB8C.quest_desc: ["侧面加速，上下接电"]
	quest.32871E311DB7FB8C.quest_subtitle: "可加速母岩与作物的生长"
