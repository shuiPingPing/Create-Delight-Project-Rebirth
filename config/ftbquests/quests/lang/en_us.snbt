	]
	quest.4879DA01FD242A10.title: "腿甲"
	quest.489072B7A17F349C.quest_desc: ["直接制作福鲁伊克斯色ME玻璃线缆即可完成任务。"]
	quest.489072B7A17F349C.quest_subtitle: "用于连接机器，传递8个频道"
